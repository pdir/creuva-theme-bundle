{% extends '@Contao/page/layout.html.twig' %}

{#
    Creuva page layout (layout type "modern").

    Slots (assign modules in the page layout):
        top     – optional bar above the header (e.g. contrast/font size switcher)
        header  – logo, navigation, CTA button
        main    – page content (articles)
        prefooter – full-width area above the footer (e.g. logo bar of partners)
        footer  – footer columns (logo, navigation, legal links)
        bottom  – bottom bar (copyright, sitemap, cookie settings); always contains
                  the "powered by contao-themes.net" link
#}

{# Settings of the page layout, overridden by the website root (see DesignSettings::resolve()) #}
{% set creuva = creuva_design(page, layout|default(null)) %}

{# Custom colors override the color scheme (see base/_schemes.scss), a custom
   logo height also makes the header grow if needed (see base/_tokens.scss) #}
{% set creuva_tokens = [
    creuva.logoHeight ? '--logo-height:%1$s;--header-height:max(4.5rem,calc(%1$s + 1rem))'|format(creuva.logoHeight),
    creuva.primary ? '--scheme-primary:#' ~ creuva.primary,
    creuva.accent ? '--scheme-accent:#%1$s;--scheme-accent-text:#%1$s;--scheme-accent-contrast:#fff;--scheme-dark-accent:color-mix(in srgb,#%1$s 60%%,#fff)'|format(creuva.accent),
]|filter(v => v)|join(';') %}

{# Variant "auto": light until the inline script in the head switches to dark #}
{% set html_attributes = attrs()
    .set('data-theme', 'auto' == creuva.variant ? 'light' : creuva.variant)
    .setIfExists('data-theme-mode', 'auto' == creuva.variant ? 'auto' : null)
    .set('data-typography', creuva.typography|default('modern'))
    .setIfExists('data-scheme', creuva.scheme ?: null)
    .set('data-radius', creuva.radius)
    .set('data-animations', creuva.animations|default('auto'))
    .setIfExists('style', creuva_tokens ? creuva_tokens|csp_unsafe_inline_style : null)
    .mergeWith(html_attributes|default)
%}

{% block head %}
    {{ parent() }}
    {# Variant "auto" (data-theme-mode): light or dark like the system setting,
       also when it changes; runs before the page is rendered. The style
       switcher uses window.creuvaUpdateTheme() for its option "System". #}
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        (() => {
            const root = document.documentElement;
            const dark = matchMedia('(prefers-color-scheme: dark)');
            const update = () => {
                if ('auto' === root.dataset.themeMode) {
                    root.dataset.theme = dark.matches ? 'dark' : 'light';
                }
            };
            update();
            dark.addEventListener('change', update);
            document.addEventListener('visibilitychange', update);
            window.creuvaUpdateTheme = update;
        })();
    </script>
    {# The web font is needed on every page: load it in parallel with the stylesheet
       (same URL as in creuva.css, without version parameter, so it is not loaded twice) #}
    <link rel="preload" href="{{ asset('plus-jakarta-sans.woff2', 'creuva_theme')|split('?')|first }}" as="font" type="font/woff2" crossorigin>
    {# SVG favicon next to the favicon of the website root, /favicon.ico remains the fallback #}
    {% set favicon_svg = creuva_favicon_svg(page) %}
    {% if favicon_svg %}
        <link rel="icon" href="/favicon.ico" sizes="32x32">
        <link rel="icon" href="{{ asset(favicon_svg) }}" type="image/svg+xml">
    {% endif %}
    <link rel="stylesheet" href="{{ asset('creuva.css', 'creuva_theme') }}">
    {# Own stylesheets of the page layout (individual adjustments) #}
    {% for stylesheet in creuva_stylesheets(layout|default(null)) %}
        <link rel="stylesheet" href="{{ asset(stylesheet) }}">
    {% endfor %}
    <script src="{{ asset('creuva.js', 'creuva_theme') }}" defer></script>
{% endblock %}

{% block body_content %}
    {# Only the main area is added to the search index, so header, footer and
       copyright texts do not appear in the search results #}
    <!-- indexer::stop -->
    <a class="c-skip-link" href="#main">{{ 'MSC.skipNavigation'|trans([], 'contao_default') }}</a>

    {% slot top %}
        <div class="l-top"><div class="l-container">{{ slot() }}</div></div>
    {% endslot %}

    {% slot header %}
        <header class="l-header" data-creuva-header>
            <div class="l-container l-header__inner">{{ slot() }}</div>
        </header>
    {% endslot %}

    <!-- indexer::continue -->
    {% slot main %}
        <main id="main" class="l-main">{{ slot() }}</main>
    {% endslot %}
    <!-- indexer::stop -->

    {# Full-width area above the footer on all pages, e.g. for a partner logo bar #}
    {% slot prefooter %}
        <div class="l-prefooter">{{ slot() }}</div>
    {% endslot %}

    {# Footer columns and the bottom bar in one footer landmark, so the copyright
       is not outside of a landmark (accessibility) #}
    <footer class="l-site-footer">
        {% slot footer %}
            <div class="l-footer">
                <div class="l-container l-footer__inner">{{ slot() }}</div>
            </div>
        {% endslot %}

        {# The copyright link is required by the theme licence (see LICENSE, section 2) #}
        <div class="l-bottom">
            <div class="l-container l-bottom__inner">
                {% slot bottom %}{{ slot() }}{% endslot %}
                <p class="c-powered-by">powered by <a href="https://contao-themes.net/creuva" hreflang="de">contao-themes.net</a></p>
            </div>
        </div>
    </footer>
    <!-- indexer::continue -->
{% endblock %}
