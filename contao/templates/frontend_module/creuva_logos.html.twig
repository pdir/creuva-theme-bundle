{% extends '@Contao/frontend_module/_base.html.twig' %}
{% use '@Contao/component/_creuva_logos.html.twig' %}

{#
    Logo bar over the full width, e.g. for partners or sponsors in the slot
    "prefooter". With the variant "primary" the bar uses the primary color
    (for white logos). Inside the content: content element creuva_logos.
#}

{% set attributes = attrs(attributes|default)
    .addClass(['c-logos', 'c-logos--' ~ variant])
    .addStyle('--logos-height:' ~ height, height)
%}

{% block wrapper_tag %}section{% endblock %}

{% block inner %}
    <div class="l-container c-logos__inner">
        {% if headline.text %}
            {{ block('headline_component') }}
        {% endif %}

        {{ block('creuva_logos_component') }}
    </div>
{% endblock %}
