{% extends '@Contao/frontend_module/_base.html.twig' %}
{% use '@Contao/component/_figure.html.twig' %}

{#
    Logo bar, e.g. for partners or sponsors. The logos link to the URL of their
    file metadata. With the variant "primary" the bar uses the primary color
    (for white logos).
#}

{% set attributes = attrs(attributes|default)
    .addClass(['c-logos', 'c-logos--' ~ variant])
    .addStyle('--logos-height:' ~ height, height)
%}

{% block wrapper_tag %}section{% endblock %}

{% block inner %}
    <div class="l-container c-logos__inner">
        {% if headline.text %}
            {{ block('headline_component') }}
        {% endif %}

        <ul class="c-logos__list">
            {% for logo in logos %}
                <li class="c-logos__item">
                    {% if logo.href %}
                        <a class="c-logos__link" href="{{ logo.href }}" target="_blank" rel="noopener">
                            {% with {figure: logo.figure} %}{{ block('figure_component') }}{% endwith %}
                        </a>
                    {% else %}
                        {% with {figure: logo.figure} %}{{ block('figure_component') }}{% endwith %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
