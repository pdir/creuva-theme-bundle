{#
    List of logos of the logo bar (content element and front end module
    creuva_logos). The figures link to the URL of their file metadata by
    themselves (link class c-logos__link, see LogoImages).
#}
{% use '@Contao/component/_figure.html.twig' %}

{% block creuva_logos_component %}
    <ul class="c-logos__list">
        {% for logo in logos %}
            <li class="c-logos__item">
                {% with {figure: logo.figure} %}{{ block('figure_component') }}{% endwith %}
            </li>
        {% endfor %}
    </ul>
{% endblock %}
