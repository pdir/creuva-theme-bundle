{#
    Icon box: small image or SVG icon, headline and text. SVG icons are shown
    as a mask in the color of the theme (CSS class "u-icon-original": in the
    colors of the file); the image stays in the markup for its alt text.
#}
{% extends '@Contao/content_element/text.html.twig' %}

{% set default_content_layout = false %}
{% set attributes = attrs(attributes|default).addClass('c-feature') %}

{% block inner %}
    {% if image %}
        {% set icon_src = image.image.imageSrc %}
        {% set icon_mask = icon_src|lower ends with '.svg' %}
        <div class="c-feature__icon{{ icon_mask ? ' has-mask' }}">
            {% if icon_mask %}
                <span class="c-icon-mask" style="mask-image: url('{{ icon_src }}')" aria-hidden="true"></span>
            {% endif %}
            {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
        </div>
    {% endif %}

    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}

    {{ block('text') }}
{% endblock %}
