        "1": {
          "id": "creuvaBackground",
          "class": "icon-eye ac-col7",
          "type": "select",
          "label": "Hintergrund",
          "values": {
            "1": {
              "title": "Weiß",
              "value": "u-bg-surface"
            },
            "2": {
              "title": "Hellgrau",
              "value": "u-bg-muted"
            },
            "3": {
              "title": "Akzent hell",
              "value": "u-bg-accent"
            },
            "4": {
              "title": "Primär (dunkel)",
              "value": "u-bg-primary"
            }
          }
        },
        "2": {
          "id": "creuvaBleed",
          "class": "icon-resize-horizontal ac-col7",
          "type": "select",
          "label": "Breite",
          "values": {
            "1": {
              "title": "Volle Breite (Hintergrund)",
              "value": "u-full-bleed"
            },
            "2": {
              "title": "Schmal (Lesebreite)",
              "value": "u-narrow"
            }
          }
        },
        "3": {
          "id": "creuvaCard",
          "class": "icon-th-large ac-col7",
          "type": "select",
          "label": "Rahmen",
          "values": {
            "1": {
              "title": "Karte",
              "value": "u-card"
            },
            "2": {
              "title": "Hervorgehoben (Preis-Karte)",
              "value": "u-featured"
            }
          }
        }
      }
    },
