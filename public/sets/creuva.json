            "1": { "title": "Weiß", "value": "u-card-white" },
            "2": { "title": "Grau", "value": "u-card-muted" },
            "3": { "title": "Akzent hell", "value": "u-card-soft" },
            "4": { "title": "Hauptfarbe", "value": "u-card-primary" },
            "5": { "title": "Akzentfarbe", "value": "u-card-accent" },
            "6": { "title": "Rahmen in Hauptfarbe", "value": "u-card-outline-primary" },
