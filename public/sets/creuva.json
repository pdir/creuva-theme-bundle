        "3": {
          "id": "creuvaGridWidths",
          "class": "icon-resize-horizontal ac-col7",
          "type": "select",
          "label": "Spaltenbreite (2 Spalten)",
          "values": {
            "1": {
              "title": "Erste Spalte breiter",
              "value": "u-cols-wide-start"
            },
            "2": {
              "title": "Zweite Spalte breiter",
              "value": "u-cols-wide-end"
            }
          }
        },
        "4": {
          "id": "creuvaGridOffset",
          "class": "icon-resize-vertical ac-col7",
          "type": "select",
          "label": "Versatz",
          "values": {
            "1": {
              "title": "Versetzt (Spalte tiefer)",
              "value": "u-grid-offset"
            }
          }
        }
