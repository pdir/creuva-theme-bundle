      "secId": "creuvaGrid",
      "secHeadline": "Raster für Elementgruppen",
      "secClass": "icon-th-large",
      "cssSet": {
        "1": {
          "id": "creuvaGridCols",
          "class": "icon-desktop ac-col7",
          "type": "select",
          "label": "Spalten",
          "values": {
            "1": {
              "title": "2 Spalten",
              "value": "u-grid-2"
