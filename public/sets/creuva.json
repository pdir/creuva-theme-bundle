        "2": {
          "id": "creuvaGridAlign",
          "class": "icon-resize-vertical ac-col7",
          "type": "select",
          "label": "Ausrichtung",
          "values": {
            "1": {
              "title": "Mittig",
              "value": "u-align-center"
